# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jebags?retryWrites=true&w=majority
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin account (seeded on first run — see src/utils/seedAdmin.js)
# ADMIN_PHONE is optional — admin logs in with email + password, not phone.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI material/color previews on the Custom Build page (Google Gemini image model)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Email (OTP + order confirmations)
# Gmail: use an App Password, not your real Gmail password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# SMS OTP provider — pick one, fill in only that section
SMS_PROVIDER=
# MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments (Razorpay) — get these from https://dashboard.razorpay.com
# Key ID + Key Secret: Settings > API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Settings > Webhooks > create a webhook pointing at
# <your domain>/api/payments/razorpay/webhook, subscribed to the Payment
# Events, Order Events, and Refund Events categories (at minimum:
# payment.captured, payment.failed, order.paid, refund.created,
# refund.processed, refund.failed). The secret you set when creating it
# goes here (not your API key secret — a different value).
RAZORPAY_WEBHOOK_SECRET=

# Shipping — wired in later, not needed yet
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
