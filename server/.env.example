# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jebags?retryWrites=true&w=majority
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin account (seeded on first run — see src/utils/seedAdmin.js)
# ADMIN_PHONE is optional — admin logs in with email + password, not phone.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (OTP + order confirmations)
# Gmail: use an App Password, not your real Gmail password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# SMS OTP provider — pick one, fill in only that section
SMS_PROVIDER=
# MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments / shipping — wired in later, not needed yet
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
